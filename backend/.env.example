LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_api_key_here

# Backend settings
APP_NAME=PlantSense AI
APP_VERSION=2.0.0
DEBUG=True
DATABASE_URL=sqlite:///./plant_disease.db
API_PREFIX=/api/v1

# ML Model settings
MODEL_MODE=balanced
YOLO11_MODEL_PATH=models/yolo11n.pt
YOLO12_MODEL_PATH=models/yolo12n.pt
YOLO26_MODEL_PATH=models/yolo26n.pt

# Thresholds
CONFIDENCE_THRESHOLD=0.70
SEVERITY_LOW_MAX=10.0
SEVERITY_MODERATE_MAX=30.0
SEVERITY_HIGH_MAX=60.0

# CORS & URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
